---
import author from '../assets/author.jpg';
import hero from '../assets/homepageImage.png';
import bat1 from '../assets/bat1.png';
import bat2 from '../assets/bat2.png';
import bat3 from '../assets/bat3.png';
import bat4 from '../assets/bat4.png';
import bat5 from '../assets/bat5.png';
import bat6 from '../assets/bat6.png';

const batFrames = [bat1.src, bat2.src, bat3.src, bat4.src, bat5.src, bat6.src];
---

<div class="splash" data-splash data-pagefind-ignore transition:persist="splash" role="dialog" aria-modal="true" aria-label="开场动画，点击跳过">
  <div class="splash-rings" data-splash-rings style={`--hero:url(${hero.src})`}></div>
  <div class="splash-veil" data-splash-veil></div>
  <div class="splash-stage" data-splash-stage>
    <div class="splash-track" data-splash-track>
      <div class="splash-bar" data-splash-bar></div>
      <div class="splash-bat" data-splash-bat aria-hidden="true">
        {batFrames.map((src, index) => (
          <span
            class:list={['splash-bat-sprite', { 'is-on': index === 3 }]}
            data-splash-bat-sprite
            style={`--bat:url(${src})`}
          ></span>
        ))}
      </div>
    </div>
  </div>
  <img class="splash-avatar" data-splash-avatar src={author.src} width="144" height="144" alt="" />
</div>

<script>
  function easeOutCubic(t: number) {
    return 1 - (1 - t) ** 3;
  }
  function easeInOutCubic(t: number) {
    return t < 0.5 ? 4 * t * t * t : 1 - ((-2 * t + 2) ** 3) / 2;
  }
  function clamp(v: number, a: number, b: number) {
    return Math.max(a, Math.min(b, v));
  }

  const FLAP = [4, 5, 6, 5, 4, 3, 2, 1, 2, 3];

  function startSplash() {
    const html = document.documentElement;
    const splash = document.querySelector<HTMLElement>('[data-splash]');
    const stage = document.querySelector<HTMLElement>('[data-splash-stage]');
    const track = document.querySelector<HTMLElement>('[data-splash-track]');
    const bar = document.querySelector<HTMLElement>('[data-splash-bar]');
    const bat = document.querySelector<HTMLElement>('[data-splash-bat]');
    const sprites = [...document.querySelectorAll<HTMLElement>('[data-splash-bat-sprite]')];
    const avatar = document.querySelector<HTMLImageElement>('[data-splash-avatar]');
    const rings = document.querySelector<HTMLElement>('[data-splash-rings]');
    const veil = document.querySelector<HTMLElement>('[data-splash-veil]');
    if (!splash || !stage || !track || !bar || !bat || sprites.length < 6 || !avatar || !rings || !veil) return;
    if (splash.dataset.started) return;
    if (!html.classList.contains('splash-pending')) {
      splash.hidden = true;
      splash.setAttribute('aria-hidden', 'true');
      return;
    }

    splash.dataset.started = 'true';
    splash.hidden = false;
    html.classList.add('splash-playing', 'splash-avatar-cover');

    let lastFrame = 3;
    const setFrame = (index: number) => {
      if (index === lastFrame || !sprites[index]) return;
      sprites[lastFrame]?.classList.remove('is-on');
      sprites[index].classList.add('is-on');
      lastFrame = index;
    };

    const size = 144;
    const T_BAR = 3.05;
    const T_FADE = 3.85;
    const T_GROW_END = 4.4;
    const T_LAND_END = 5.1;
    const T_VEIL_DUR = 1.05;
    const T_DONE = 5.2;

    const setAvatarBox = (x: number, y: number, w: number) => {
      avatar.style.opacity = '1';
      avatar.style.width = `${w}px`;
      avatar.style.height = `${w}px`;
      avatar.style.transform = `translate(${x}px, ${y}px)`;
    };

    let start = 0;
    let frame = 0;
    let stopped = false;
    let landFrom: DOMRect | null = null;
    let landTo: DOMRect | null = null;

    const finish = () => {
      if (stopped) return;
      stopped = true;
      cancelAnimationFrame(frame);
      html.classList.remove('splash-pending', 'splash-playing', 'splash-avatar-cover');
      document.removeEventListener('keydown', onKey);
      try { sessionStorage.setItem('splash-done', '1'); } catch {}
      splash.hidden = true;
      splash.setAttribute('aria-hidden', 'true');
    };

    splash.addEventListener('click', finish, { once: true });
    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') finish();
    };
    document.addEventListener('keydown', onKey);
    document.querySelector('.skip-link')?.addEventListener('click', finish, { once: true });

    const tick = (now: number) => {
      if (stopped) return;
      if (!start) start = now;
      const t = (now - start) / 1000;
      const batW = bat.offsetWidth || 98;
      const travel = Math.max(0, track.clientWidth - batW - 6);

      if (t < T_FADE) {
        const p = easeInOutCubic(clamp(t / T_BAR, 0, 1));
        const batX = p * travel;
        const padL = parseFloat(getComputedStyle(track).paddingLeft) || 0;
        const inner = Math.max(1, track.clientWidth - padL - (parseFloat(getComputedStyle(track).paddingRight) || 0));
        const flapIndex = FLAP[Math.floor(t * 14) % FLAP.length] - 1;
        setFrame(flapIndex);
        const appear = easeOutCubic(clamp(p / 0.14, 0, 1));
        const leave = easeInOutCubic(clamp((p - 0.94) / 0.06, 0, 1));
        const barFollow = easeOutCubic(clamp((p - 0.08) / 0.14, 0, 1));
        const follow = clamp(batX + 6, 0, inner) * barFollow;
        bar.style.width = `${follow + (inner - follow) * leave}px`;
        const scale = 0.2 + 0.8 * appear * (1 - leave);
        const fade = appear * (1 - leave);
        const bob = Math.sin(t * 2.2) * 1.4 * (1 - leave);
        bat.style.transformOrigin = leave > 0 ? '100% 58%' : '0% 58%';
        bat.style.opacity = String(fade);
        bat.style.transform = `translate3d(${batX}px, calc(-58% + ${bob}px), 0) scale(${scale})`;
        stage.style.opacity = t < T_BAR ? '1' : String(1 - (t - T_BAR) / (T_FADE - T_BAR));
        rings.style.backgroundPosition = 'center, center 42%';
      } else {
        stage.style.opacity = '0';
        const cx = window.innerWidth / 2;
        const cy = window.innerHeight / 2;
        const zoom = easeInOutCubic(clamp((t - T_FADE) / (T_LAND_END - T_FADE), 0, 1));
        rings.style.backgroundPosition = `center, center ${42 * (1 - zoom)}%`;
        if (t < T_GROW_END) {
          const k = easeOutCubic(clamp((t - T_FADE) / (T_GROW_END - T_FADE), 0, 1));
          const box = size * (0.18 + 0.82 * k);
          setAvatarBox(cx - box / 2, cy - box / 2, box);
        } else {
          if (!landFrom) {
            landFrom = new DOMRect(cx - size / 2, cy - size / 2, size, size);
            const profile = document.querySelector<HTMLImageElement>('.profile-card img');
            landTo = profile?.getBoundingClientRect() || null;
          }
          if (landTo && landTo.width > 24) {
            const k = easeInOutCubic(clamp((t - T_GROW_END) / (T_LAND_END - T_GROW_END), 0, 1));
            setAvatarBox(
              landFrom.x + (landTo.x - landFrom.x) * k,
              landFrom.y + (landTo.y - landFrom.y) * k,
              landFrom.width + (landTo.width - landFrom.width) * k,
            );
          } else {
            setAvatarBox(cx - size / 2, cy - size / 2, size);
          }
        }
        veil.style.opacity = String(1 - clamp((t - T_FADE) / T_VEIL_DUR, 0, 1));
      }

      if (t >= T_DONE) finish();
      else frame = requestAnimationFrame(tick);
    };

    frame = requestAnimationFrame(tick);
  }

  startSplash();
  document.addEventListener('astro:page-load', startSplash);
</script>
