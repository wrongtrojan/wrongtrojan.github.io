---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site } from '../data/site';
import { entryPath, isIndex, plainSummary } from '../utils/content';
import hero from '../assets/homepageImage.png';
import author from '../assets/author.jpg';

const dated = (entry: { data: { draft?: boolean; date?: Date } }) => !entry.data.draft && Boolean(entry.data.date);

const notes = (await getCollection('note', dated))
  .filter((entry) => !isIndex(entry))
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));

const novels = (await getCollection('create', dated))
  .filter((entry) => !isIndex(entry))
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));

const latestNotes = notes.slice(0, 3);
const latestNovels = novels.slice(0, 3);
---

<Layout>
  <section class="profile-hero" style={`--hero:url(${hero.src})`}>
    <div class="profile-hero-image"></div>
    <div class="profile-hero-blur" data-profile-blur></div>
    <div class="profile-card shell">
      <img src={author.src} width="144" height="144" alt="木马的头像" />
      <h1>{site.author}</h1>
      <a class="profile-github" href={site.github} rel="me" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85.01 1.71.12 2.51.34 1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"/></svg>
      </a>
    </div>
  </section>

  <div class="home-feed" data-pagefind-ignore>
    <div class="home-rule" aria-hidden="true"></div>
    <section class="recent-section shell">
      <div class="recent-section-heading">
        <h2>笔记</h2>
        <a class="section-more" href="/note/">查看更多 <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list preview-grid">
        {latestNotes.map((entry) => (
          <ArticleCard
            href={entryPath(entry)}
            title={entry.data.title}
            summary={plainSummary(entry.body, entry.data.description)}
            badge="笔记"
            meta={entry.data.date ? [entry.data.date.toISOString().slice(0, 10)] : []}
            transitionName={`title-${entry.id}`}
          />
        ))}
      </div>
    </section>

    <section class="recent-section shell">
      <div class="recent-section-heading">
        <h2>创作</h2>
        <a class="section-more" href="/create/novel/">查看更多 <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list preview-grid">
        {latestNovels.map((entry) => (
          <ArticleCard
            href={entryPath(entry)}
            title={entry.data.title}
            summary={plainSummary(entry.body, entry.data.description)}
            badge="创作"
            meta={entry.data.date ? [entry.data.date.toISOString().slice(0, 10)] : []}
            transitionName={`title-${entry.id}`}
          />
        ))}
      </div>
    </section>
  </div>

  <script>
    function setupProfileHero() {
      const blur = document.querySelector<HTMLElement>('[data-profile-blur]');
      if (!blur || blur.dataset.ready) return;
      blur.dataset.ready = 'true';
      const update = () => { blur.style.opacity = String(Math.min(1, window.scrollY / 300)); };
      update();
      window.addEventListener('scroll', update, { passive: true });
    }
    setupProfileHero();
    document.addEventListener('astro:page-load', setupProfileHero);
  </script>
</Layout>
